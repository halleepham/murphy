# Data. The raw 1.7 GB download stays out; the processed table goes in, because
# committing it is what lets the app deploy and lets anyone clone and run this
# without the download. Eleven files, ~8 MB each.
data/raw/
*.csv
!tests/fixtures/*.csv
!data/processed/flights/**/*.parquet
# A 300-row sample IS committed: it documents the schema and lets anyone
# inspect the columns without the 1.6 GB download.
!data/raw/sample_rows_2024.csv

# Secrets
.env

# Private planning docs — local only, never committed
docs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# AI context
CLAUDE.md

# Cached LLM parses -- avoids re-spending the free-tier daily quota
.cache/
