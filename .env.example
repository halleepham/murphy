# Copy to .env and fill in. .env is gitignored and must never be committed.
# A test in tests/test_environment.py asserts that.

# --- Neo4j (Challenge 3 onward) ---
# Note for Neo4j Aura: the database name and username are derived from the
# instance id, not the literal "neo4j". Check the credentials file Aura gives
# you at instance creation — it is the only time the password is shown.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- LLM provider: Groq free tier (docs/decisions/0005) ---
# console.groq.com -> API Keys -> Create API Key. Starts with "gsk_".
GROQ_API_KEY=

# --- Hugging Face (deployment later; model downloads) ---
# huggingface.co -> Settings -> Access Tokens -> Create new token.
# Token type "Write" (deploying a Space pushes to it). Starts with "hf_".
HF_TOKEN=
