# Copy to .env and fill in. Never commit .env.

# Primary parser. Free key from https://console.groq.com -> API Keys
GROQ_API_KEY=

# Optional backup. Free key from https://aistudio.google.com -> Get API key
# Note: the Gemini free tier allows only 20 requests per day per model.
GEMINI_API_KEY=

# Knowledge graph (Challenge 3). Create a free instance at https://console.neo4j.io
# and use "Download credentials" -- Aura names the user and the database after the
# instance id, not "neo4j", so copy all four values rather than assuming defaults.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
