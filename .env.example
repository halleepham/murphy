# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Neo4j: the knowledge graph (Neo4j Aura Free works) ---
# On Aura, the database name and username come from the instance id, not the
# literal "neo4j". The password is shown once, when the instance is created.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- Groq free tier: the LLM that explains GraphRAG answers ---
# console.groq.com -> API Keys -> Create API Key. Starts with "gsk_".
GROQ_API_KEY=
